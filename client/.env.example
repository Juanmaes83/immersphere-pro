# ─── API ─────────────────────────────────────────────────────────────────────
# Desarrollo local:
# VITE_API_BASE_URL=http://localhost:4000/api
# Producción Railway:
VITE_API_BASE_URL=https://immersphere-pro-production.up.railway.app/api

# ─── APP ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Immersphere Pro

# ─── 25D.1: SuperSplat Viewer self-hosted ────────────────────────────────────
# Base URL of the deployed supersplat-viewer static app (MIT, playcanvas/supersplat-viewer).
# When set, outputAssets of type 'supersplat_self_hosted' load inside an iframe pointing
# to {VITE_SUPERSPLAT_VIEWER_URL}?content={assetUrl}&noui
# Leave empty to disable; existing supersplat external viewer continues to work unchanged.
#
# Deploy: clone https://github.com/playcanvas/supersplat-viewer → npm run build → deploy dist/ to Vercel
# Example:
# VITE_SUPERSPLAT_VIEWER_URL=https://viewer-immersphere.vercel.app
VITE_SUPERSPLAT_VIEWER_URL=

# Feature flags (experimental native viewers — keep false in production until validated)
VITE_ENABLE_NATIVE_3D_VIEWER=false
VITE_ENABLE_NATIVE_SPLAT_VIEWER=false
