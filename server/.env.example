# ─── ENTORNO ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── CORS / URLs ─────────────────────────────────────────────────────────────
# Producción: https://immersphere-pro.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# URL pública del frontend (usada en redirects de Stripe)
APP_URL=http://localhost:5173
# URL pública del backend (referencia interna)
API_URL=http://localhost:4000

# ─── BASE DE DATOS ───────────────────────────────────────────────────────────
# Desarrollo: file:./dev.db
# Producción: postgresql://USER:PASSWORD@HOST:PORT/DB  (Railway PostgreSQL)
DATABASE_URL=file:./dev.db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=immersphere_access_secret_dev_change_in_production_64_chars
JWT_REFRESH_SECRET=immersphere_refresh_secret_dev_change_in_production_64_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# ─── BCRYPT ──────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── STRIPE ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs de Stripe (obtenlos en dashboard.stripe.com → Products)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# ─── CLOUDINARY ──────────────────────────────────────────────────────────────
# Credenciales en: cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=immersphere-pro

# ─── RESEND (email de notificación de leads) ─────────────────────────────────
# Credenciales en: resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tudominio.com

# ─── WEBHOOKS OPCIONALES ─────────────────────────────────────────────────────
# URL a la que se notifica cuando se genera un lead (vacío = desactivado)
LEAD_NOTIFICATION_WEBHOOK_URL=
