generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String @id @default(uuid())
  name         String
  slug         String @unique
  logoText     String @default("IP")
  logoUrl      String @default("")
  primaryColor String @default("#7C3AED")
  webhookUrl   String @default("")
  phone        String @default("")

  plan            String  @default("STARTER")
  removeBranding  Boolean @default(false)
  whatsappNumber  String  @default("")
  calendlyUrl     String  @default("")
  pdfReportsEnabled Boolean @default(false)
  createdAt     DateTime       @default(now())
  users         User[]
  properties    Property[]
  captureJobs   CaptureJob[]
  captureHotspots CaptureHotspot[]
  captureLeads CaptureLead[]
  captureAiProcessingRuns CaptureAiProcessingRun[]
  subscription  Subscription?
  refreshTokens RefreshToken[]

  @@index([slug])
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  name         String

  avatarUrl     String         @default("")
  role          String         @default("TENANTADMIN")
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  captureJobs   CaptureJob[]
  captureAiProcessingRuns CaptureAiProcessingRun[]

  @@index([tenantId])
  @@index([email])
}

model Property {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  type        String   @default("APARTMENT")
  status      String   @default("DRAFT")
  price       Int      @default(0)
  area        Int      @default(0)
  rooms       Int      @default(0)
  bathrooms   Int      @default(0)
  coverImage      String   @default("")
  floorplanUrl    String   @default("")
  heroVideoUrl    String   @default("")
  heroVideoPoster String   @default("")
  address         String   @default("")
  latitude      Float?
  longitude     Float?
  language      String   @default("es")
  passwordHash  String?
  views         Int      @default(0)
  guidedConfig  Json?
  spaces        Space[]
  leads         Lead[]
  captureJobs   CaptureJob[]
  viewerEvents  ViewerEvent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([price])
  @@index([area])
}

model Space {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(1)
  status     String   @default("ACTIVE")
  dimensions String?
  storySubheadline String  @default("")
  storyHighlight   String  @default("")
  ctaLabel         String  @default("")
  ctaSubtext       String  @default("")
  floorplanPin     Json?
  ambientAudio     String  @default("")
  guidedDuration   Int     @default(10)
  assets     Asset[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId])
  @@index([order])
  @@index([status])
}

model Asset {
  id        String    @id @default(uuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  type      String
  url       String
  thumbnail String    @default("")
  format    String
  size      Int       @default(0)
  hotspots  Hotspot[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([spaceId])
  @@index([type])
}

model Hotspot {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label         String
  type          String
  position      String
  body          String   @default("")
  metric        String   @default("")
  targetSpaceId String?
  actionType    String   @default("")
  actionPayload Json?
  ctaLabel      String   @default("")
  displayMode   String   @default("")
  trackingLabel String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([assetId])
  @@index([type])
}

model Lead {
  id             String    @id @default(uuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  email          String
  phone          String    @default("")
  notes          String    @default("")
  source         String    @default("viewer")
  createdAt      DateTime  @default(now())
  status         String    @default("nuevo")
  internalNote   String    @default("")
  nextActionAt   DateTime?
  nextActionText String    @default("")
  propertySlug   String    @default("")
  spaceId        String    @default("")
  spaceName      String    @default("")
  assetId        String    @default("")
  hotspotId      String    @default("")
  hotspotLabel   String    @default("")
  actionType     String    @default("")
  ctaLabel       String    @default("")
  sessionId      String    @default("")
  origin         String    @default("")
  referrer       String    @default("")
  guidedStepId   String    @default("")
  guidedStepTitle String   @default("")
  updatedAt      DateTime  @default(now()) @updatedAt
  captureJobs    CaptureJob[]

  @@index([propertyId])
  @@index([email])
  @@index([status])
}

model CaptureJob {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  title           String
  clientName      String
  projectType     String   @default("property")
  vertical        String   @default("real_estate")
  status          String   @default("draft")
  priority        String   @default("medium")
  source          String   @default("manual")
  assignedTo      String   @default("")
  dueDate         DateTime?
  estimatedCost   Int?
  estimatedHours  Int?
  commercialValue Int?
  commercialBrief Json?
  commercialBriefUpdatedAt DateTime?
  commercialBriefCompleteness Int?
  appliedAiContent Json?
  appliedAiContentUpdatedAt DateTime?
  riskLevel       String   @default("low")
  nextAction      String   @default("")
  notes           String   @default("")
  publicUrl       String   @default("")
  qrUrl           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  inputAssets     CaptureInputAsset[]
  outputAssets    CaptureOutputAsset[]
  aiProcessingRuns CaptureAiProcessingRun[]
  hotspots        CaptureHotspot[]
  captureLeads    CaptureLead[]

  @@index([tenantId])
  @@index([userId])
  @@index([leadId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([riskLevel])
  @@index([dueDate])
}

model CaptureLead {
  id           String     @id @default(uuid())
  captureJobId String
  captureJob   CaptureJob @relation(fields: [captureJobId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String     @default("")
  message      String     @default("")
  interestType String     @default("general")
  source       String     @default("capture_public")
  status       String     @default("new")
  userAgent    String     @default("")
  ipHash       String     @default("")
  consent      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([captureJobId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model CaptureHotspot {
  id                String     @id @default(uuid())
  captureJobId      String
  captureJob        CaptureJob @relation(fields: [captureJobId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceRunId       String?
  label             String
  description       String
  roomOrZone        String     @default("")
  hotspotType       String
  priority          String
  cta               String     @default("")
  mediaSuggestion   String     @default("")
  businessObjective String     @default("")
  position          Json?
  status            String     @default("draft")
  isPublic          Boolean    @default(false)
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([captureJobId])
  @@index([tenantId])
  @@index([status])
  @@index([isPublic])
}

model CaptureAiProcessingRun {
  id            String     @id @default(uuid())
  captureJobId  String
  captureJob    CaptureJob @relation(fields: [captureJobId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        String
  promptVersion String
  inputSummary  Json
  result        Json?
  error         String?
  model         String?
  tokensInput   Int?
  tokensOutput  Int?
  estimatedCostUsd Float?
  attempts      Int        @default(0)
  maxAttempts   Int        @default(2)
  queuedAt      DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  lockedAt      DateTime?
  lockedBy      String?
  nextRetryAt   DateTime?
  cancelledAt   DateTime?
  lastHeartbeatAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([captureJobId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([status, nextRetryAt])
  @@index([lockedAt])
  @@index([createdAt])
}

model CaptureInputAsset {
  id            String     @id @default(uuid())
  captureJobId  String
  captureJob    CaptureJob @relation(fields: [captureJobId], references: [id], onDelete: Cascade)
  type          String
  zone          String     @default("")
  assetType     String     @default("other")
  filename      String     @default("")
  url           String
  publicId      String     @default("")
  source        String     @default("manual")
  format        String     @default("")
  mimeType      String     @default("")
  size          Int        @default(0)
  sizeBytes     Int        @default(0)
  status        String     @default("received")
  captureQualityStatus String @default("pending")
  rightsStatus  String     @default("unknown")
  qualityScore  Int?
  notes         String     @default("")
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([captureJobId])
  @@index([type])
  @@index([zone])
  @@index([assetType])
  @@index([status])
  @@index([captureQualityStatus])
}

model CaptureOutputAsset {
  id               String     @id @default(uuid())
  captureJobId     String
  captureJob       CaptureJob @relation(fields: [captureJobId], references: [id], onDelete: Cascade)
  type             String
  format           String     @default("")
  url              String
  publicId         String     @default("")
  status           String     @default("planned")
  viewerReady      Boolean    @default(false)
  mobileReady      Boolean    @default(false)
  publishedUrl     String     @default("")
  qrUrl            String     @default("")
  analyticsEnabled Boolean    @default(false)
  notes            String     @default("")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([captureJobId])
  @@index([type])
  @@index([status])
}

model Subscription {
  id                   String @id @default(uuid())
  tenantId             String @unique
  tenant               Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeCustomerId     String @default("")
  stripeSubscriptionId String @default("")

  plan      String   @default("STARTER")
  status    String   @default("TRIAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model ViewerEvent {
  id         String   @id @default(uuid())
  tenantId   String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  spaceId    String?
  assetId    String?
  type       String
  label      String?
  payload    String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([propertyId])
  @@index([type])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}
